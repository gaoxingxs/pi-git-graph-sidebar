{
  "name": "pi-git-graph-sidebar",
  "version": "0.2.0",
  "description": "A VS Code Git Graph-style commit graph for the Pi coding agent, in the TUI and in Pi Web, with a repository picker for directories that hold several.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "git",
    "git-graph",
    "tui",
    "pi-web",
    "multi-repo"
  ],
  "license": "MIT",
  "author": "yuxiang-gao",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuxiang-gao/pi-git-graph-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/yuxiang-gao/pi-git-graph-sidebar/issues"
  },
  "homepage": "https://github.com/yuxiang-gao/pi-git-graph-sidebar#readme",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
